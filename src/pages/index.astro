---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getImagePath } from '../utils/images';

// Use local image instead of remote URL
const bgImagePath = getImagePath('bg.jpg');

// SVG Icons - Modern Lucide-style icons
const icons = {
  map: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>`,
  database: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>`,
  school: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 22v-4a2 2 0 1 0-4 0v4"></path><path d="m18 10 4-2-8-4-8 4 4 2"></path><path d="M18 5v9"></path><path d="m6 12 8 4 7-3v-5"></path><path d="m4 17 6 3 6-3v-3"></path></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
  brain: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg>`,
  globe: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`
};

// Services with metrics for credibility
const services = [
  {
    icon: 'brain',
    title: 'GeoAI & Machine Learning',
    description: 'AI-powered archaeological detection at national scale. Our deep learning pipeline processed 70M LiDAR tiles across Afghanistan in under a week—a task requiring 6 months manually.',
    href: '/projects/geoai/',
    metric: '70M+',
    metricLabel: 'LiDAR tiles processed',
    featured: true,
    gradient: 'from-blue-600/20 to-cyan-500/20'
  },
  {
    icon: 'map',
    title: 'GIS Software',
    description: 'Access ArcGIS Pro, QGIS, GRASS GIS, and specialized geospatial tools.',
    href: '/resources/software/',
    metric: '15+',
    metricLabel: 'software tools',
    gradient: 'from-primary/10 to-accent/10'
  },
  {
    icon: 'database',
    title: 'Geocoding Service',
    description: 'Enterprise batch geocoding with ESRI World Geocoder. High accuracy for research data.',
    href: '/services/geocoding/',
    metric: '50K+',
    metricLabel: 'records per batch',
    gradient: 'from-emerald-500/10 to-teal-500/10'
  },
  {
    icon: 'school',
    title: 'Workshops & Training',
    description: 'Hands-on GIS workshops, tutorials, and learning resources for all skill levels.',
    href: '/workshops/',
    metric: '20+',
    metricLabel: 'workshop topics',
    gradient: 'from-violet-500/10 to-purple-500/10'
  },
  {
    icon: 'globe',
    title: 'WebGIS Applications',
    description: 'Custom web mapping solutions for research visualization and data sharing.',
    href: '/projects/webgis/',
    metric: '5+',
    metricLabel: 'projects in pipeline',
    gradient: 'from-orange-500/10 to-amber-500/10'
  },
  {
    icon: 'users',
    title: 'Research Support',
    description: 'Expert consultation, technical assistance, and collaboration on spatial research.',
    href: '/contact/',
    metric: '100+',
    metricLabel: 'researchers supported',
    gradient: 'from-rose-500/10 to-pink-500/10'
  }
];
---

<Layout title="CyberGIS at UChicago">
  <!-- Hero Section - Split Screen Design -->
  <section class="relative min-h-[90vh] w-full overflow-hidden bg-gradient-to-br from-slate-50 to-slate-100">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-30">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgb(148 163 184 / 0.3) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 min-h-[90vh] items-center">
        <!-- Left Content (60%) -->
        <div class="lg:col-span-3 pt-24 lg:pt-0 animate-fade-in-up">
          <div class="max-w-2xl">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
              <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
              University of Chicago Research Computing Center
            </div>
            
            <!-- Main Heading -->
            <h1 class="font-display text-display-lg md:text-display-xl text-foreground mb-6 leading-tight">
              Advancing<br />
              <span class="text-primary">Spatial Intelligence</span>
            </h1>
            
            <!-- Subheading -->
            <p class="text-body-lg md:text-xl text-muted-foreground mb-8 max-w-xl leading-relaxed">
              Empowering research through cutting-edge geospatial computing, AI-driven analytics, and comprehensive GIS services.
            </p>
            
            <!-- CTA Buttons -->
            <div class="flex flex-wrap gap-4">
              <a 
                href="/resources/" 
                class="group inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-3.5 rounded-lg font-medium transition-all duration-300 hover:shadow-lg hover:shadow-primary/25"
              >
                Explore Resources
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
              <a 
                href="/contact/" 
                class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-foreground px-6 py-3.5 rounded-lg font-medium border border-border transition-all duration-300 hover:shadow-md"
              >
                Get Support
              </a>
            </div>
            
            <!-- Quick Stats -->
            <div class="flex flex-wrap gap-8 mt-12 pt-8 border-t border-border/50">
              <div class="animate-fade-in delay-200">
                <div class="text-3xl font-bold text-primary counter">70M+</div>
                <div class="text-sm text-muted-foreground">LiDAR Tiles Processed</div>
              </div>
              <div class="animate-fade-in delay-300">
                <div class="text-3xl font-bold text-primary counter">100+</div>
                <div class="text-sm text-muted-foreground">Researchers Supported</div>
              </div>
              <div class="animate-fade-in delay-400">
                <div class="text-3xl font-bold text-primary counter">650K</div>
                <div class="text-sm text-muted-foreground">km² Analyzed</div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Visual (40%) -->
        <div class="lg:col-span-2 relative animate-fade-in delay-200">
          <div class="relative aspect-square max-w-lg mx-auto">
            <!-- Animated Background Circles -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="absolute w-[80%] h-[80%] rounded-full border border-primary/20 animate-pulse"></div>
              <div class="absolute w-[60%] h-[60%] rounded-full border border-accent/30"></div>
              <div class="absolute w-[40%] h-[40%] rounded-full bg-gradient-to-br from-primary/10 to-accent/10"></div>
            </div>
            
            <!-- Central Visual -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="relative w-64 h-64 md:w-80 md:h-80">
                <!-- Map/GIS Visual Placeholder -->
                <div class="absolute inset-0 rounded-2xl overflow-hidden shadow-2xl border border-white/50">
                  <Image 
                    src={bgImagePath}
                    alt="GIS Visualization"
                    width={400}
                    height={400}
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-transparent to-transparent"></div>
                  
                  <!-- Overlay Elements -->
                  <div class="absolute bottom-4 left-4 right-4">
                    <div class="glass rounded-lg p-3">
                      <div class="flex items-center gap-2 text-sm text-foreground">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                        <span class="font-medium">Live Processing</span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Floating Cards -->
                <div class="absolute -top-4 -right-4 glass rounded-xl p-3 shadow-lg animate-fade-in delay-300">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary" set:html={icons.brain}></div>
                    <div class="text-xs">
                      <div class="font-semibold text-foreground">GeoAI</div>
                      <div class="text-muted-foreground">Active</div>
                    </div>
                  </div>
                </div>
                
                <div class="absolute -bottom-4 -left-4 glass rounded-xl p-3 shadow-lg animate-fade-in delay-400">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent" set:html={icons.globe}></div>
                    <div class="text-xs">
                      <div class="font-semibold text-foreground">WebGIS</div>
                      <div class="text-muted-foreground">5+ Projects</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </section>

  <!-- Services Section - Bento Box Layout -->
  <section class="py-20 lg:py-28 bg-background" id="services">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mx-auto text-center mb-16 animate-on-scroll">
        <h2 class="font-heading text-display-md text-foreground mb-4">Our Services</h2>
        <p class="text-body-lg text-muted-foreground">
          Comprehensive geospatial solutions for research, analysis, and innovation.
        </p>
      </div>
      
      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {services.map((service, index) => (
          <a 
            href={service.href}
            class:list={[
              "group relative block rounded-2xl border border-border/50 overflow-hidden transition-all duration-500",
              "hover-lift hover:border-primary/30",
              service.featured ? "md:col-span-2 lg:col-span-2 md:row-span-2" : "",
              "animate-on-scroll"
            ]}
            style={`animation-delay: ${index * 100}ms`}
          >
            {/* Gradient Background */}
            <div class={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
            
            {/* Glass Effect on Hover */}
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 backdrop-blur-[2px]"></div>
            
            <div class:list={[
              "relative p-6 lg:p-8 h-full flex flex-col",
              service.featured ? "min-h-[400px]" : "min-h-[200px]"
            ]}>
              {/* Icon */}
              <div class:list={[
                "flex items-center justify-center rounded-xl bg-primary/10 text-primary transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:scale-110",
                service.featured ? "w-16 h-16 mb-6" : "w-12 h-12 mb-4"
              ]}>
                <span set:html={icons[service.icon]} />
              </div>
              
              {/* Content */}
              <div class="flex-1">
                <h3 class:list={[
                  "font-heading font-semibold text-foreground mb-2 group-hover:text-primary transition-colors",
                  service.featured ? "text-heading-xl" : "text-heading-md"
                ]}>
                  {service.title}
                </h3>
                <p class:list={[
                  "text-muted-foreground leading-relaxed",
                  service.featured ? "text-body-lg" : "text-body-md"
                ]}>
                  {service.description}
                </p>
              </div>
              
              {/* Metric Badge */}
              <div class="mt-6 pt-4 border-t border-border/50 flex items-center justify-between">
                <div>
                  <span class:list={[
                    "font-bold text-primary counter",
                    service.featured ? "text-2xl" : "text-xl"
                  ]}>
                    {service.metric}
                  </span>
                  <span class="text-sm text-muted-foreground ml-2">{service.metricLabel}</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Metrics Section -->
  <section class="py-20 lg:py-24 bg-gradient-to-b from-background to-muted/30 overflow-hidden">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mx-auto text-center mb-16 animate-on-scroll">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
          Our Impact
        </div>
        <h2 class="font-heading text-display-md text-foreground mb-4">Driving Research Forward</h2>
        <p class="text-body-lg text-muted-foreground">
          Measurable outcomes from our geospatial computing and AI initiatives.
        </p>
      </div>
      
      <!-- Metrics Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <!-- Metric 1: LiDAR Tiles -->
        <div class="group relative p-6 lg:p-8 rounded-2xl bg-white border border-border/50 hover-lift animate-on-scroll text-center">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-cyan-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-blue-500/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
              </svg>
            </div>
            <div class="text-4xl lg:text-5xl font-bold text-foreground mb-1 counter" data-target="70000000">70M+</div>
            <div class="text-sm text-muted-foreground font-medium">LiDAR Tiles Processed</div>
            <div class="text-xs text-muted-foreground/70 mt-1">AHMP Afghanistan Project</div>
          </div>
        </div>
        
        <!-- Metric 2: Area Analyzed -->
        <div class="group relative p-6 lg:p-8 rounded-2xl bg-white border border-border/50 hover-lift animate-on-scroll delay-100 text-center">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-emerald-500/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="text-4xl lg:text-5xl font-bold text-foreground mb-1 counter">650K</div>
            <div class="text-sm text-muted-foreground font-medium">km² Analyzed</div>
            <div class="text-xs text-muted-foreground/70 mt-1">National-scale coverage</div>
          </div>
        </div>
        
        <!-- Metric 3: Archaeological Sites -->
        <div class="group relative p-6 lg:p-8 rounded-2xl bg-white border border-border/50 hover-lift animate-on-scroll delay-200 text-center">
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-orange-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-amber-500/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <div class="text-4xl lg:text-5xl font-bold text-foreground mb-1 counter">11.9K</div>
            <div class="text-sm text-muted-foreground font-medium">Sites Identified</div>
            <div class="text-xs text-muted-foreground/70 mt-1">30% database expansion</div>
          </div>
        </div>
        
        <!-- Metric 4: Speed Improvement -->
        <div class="group relative p-6 lg:p-8 rounded-2xl bg-white border border-border/50 hover-lift animate-on-scroll delay-300 text-center">
          <div class="absolute inset-0 bg-gradient-to-br from-violet-500/5 to-purple-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-violet-500/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div class="text-4xl lg:text-5xl font-bold text-foreground mb-1 counter">10x</div>
            <div class="text-sm text-muted-foreground font-medium">Faster Processing</div>
            <div class="text-xs text-muted-foreground/70 mt-1">vs. manual methods</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="py-20 lg:py-28 bg-muted/50 overflow-hidden">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
        <div class="animate-on-scroll">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">
            Featured Work
          </div>
          <h2 class="font-heading text-display-md text-foreground mb-2">Research Projects</h2>
          <p class="text-body-lg text-muted-foreground max-w-xl">
            Pioneering spatial research through AI, deep learning, and advanced computing.
          </p>
        </div>
        <a 
          href="/projects/" 
          class="inline-flex items-center gap-2 text-primary font-medium hover:gap-3 transition-all animate-on-scroll"
        >
          View all projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      
      <!-- Projects Carousel -->
      <div class="relative">
        <div class="flex gap-6 overflow-x-auto pb-4 scroll-snap-x scrollbar-hide -mx-4 px-4 lg:mx-0 lg:px-0">
          <!-- Project 1: GeoAI/AHMP -->
          <a 
            href="/projects/geoai/"
            class="group flex-shrink-0 w-[340px] lg:w-[400px] scroll-snap-item animate-on-scroll"
          >
            <div class="relative rounded-2xl overflow-hidden bg-white border border-border/50 hover-lift transition-all duration-500">
              <!-- Project Image -->
              <div class="relative h-48 lg:h-56 overflow-hidden">
                <picture>
                  <source
                    srcset="/images/projects/geoai-cover-w400.webp 400w, /images/projects/geoai-cover-w800.webp 800w"
                    type="image/webp"
                  />
                  <img 
                    src="/images/projects/geoai-cover.png" 
                    srcset="/images/projects/geoai-cover-w400.png 400w, /images/projects/geoai-cover-w800.png 800w"
                    sizes="(max-width: 640px) 340px, 400px"
                    alt="GeoAI - Afghan Heritage Mapping"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 rounded-full bg-blue-500 text-white text-xs font-medium">GeoAI</span>
                </div>
                <div class="absolute bottom-4 left-4 right-4">
                  <div class="flex items-center gap-2 text-white/90 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
